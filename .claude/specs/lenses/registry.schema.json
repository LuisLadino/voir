{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lens Registry",
  "description": "Schema for .claude/specs/lenses/registry.json. Validated at load by lens-router.cjs. See #133.",
  "type": "object",
  "required": ["$schema_version", "attachment_points", "lenses"],
  "properties": {
    "$schema_version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "attachment_points": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "lenses": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": ["moves"],
          "properties": {
            "description": { "type": "string" },
            "moves": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "triggers", "skill"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                  "attachment": { "type": "string" },
                  "triggers": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "minItems": 1
                  },
                  "skill": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
